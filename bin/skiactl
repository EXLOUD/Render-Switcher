#!/system/bin/sh
MODDIR="/data/adb/modules/render_switcher"
[ -d "$MODDIR/common" ] || MODDIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

. "$MODDIR/common/state.sh"
. "$MODDIR/common/utils.sh"
. "$MODDIR/common/logging.sh"
. "$MODDIR/common/properties.sh"
. "$MODDIR/common/targets.sh"

ensure_persistent_state
load_settings
_targets_sync_module

usage() {
    cat <<'U'
Render Switcher control

  skiactl status
  skiactl renderer get|set <skiavk|skiagl>
  skiactl target list
  skiactl target add <pkg> <renderer>
  skiactl target remove <pkg>
  skiactl target get <pkg>
  skiactl target set <pkg> <renderer>
  skiactl target enable|disable <pkg>
  skiactl enforcement status|reset
  skiactl zygisk [-v]        ok | missing | unknown (exit 0|1|2)
  skiactl logs
  skiactl packages [user|system|all]
  skiactl help

Per-app overrides are applied by the Zygisk companion reading targets.conf.
U
}

cmd_status() {
    echo "Render Switcher status"
    echo "-------------"
    echo "Global renderer : $(renderer_get_global)"
    if [ "$ENFORCEMENT_DISABLED" = "1" ]; then
        echo "Enforcement     : DISABLED (bootloop guard) - run: skiactl enforcement reset"
    else
        echo "Enforcement     : active"
    fi
    echo "Data dir        : $DATA_DIR"
    echo "Targets file    : $TARGETS_CONF"
    echo "Per-app path    : Zygisk (targets.conf)"
    echo ""
    echo "Targets:"
    _st_list=$(target_list)
    if [ -n "$_st_list" ]; then
        echo "$_st_list"
    else
        echo "(none)"
    fi
}

cmd_renderer() {
    case "$1" in
        get) renderer_get_global ;;
        set)
            is_valid_renderer "$2" || { echo "Use skiavk or skiagl" >&2; exit 1; }
            if renderer_set_global "$2"; then
                save_setting GLOBAL_RENDERER "$2"
                echo "Global renderer set to $2"
            else
                echo "ERROR: could not set debug.hwui.renderer=$2 (see: skiactl logs)" >&2
                exit 5
            fi
            ;;
        *) echo "renderer get|set" >&2; exit 1 ;;
    esac
}

# Restart the app so the Zygisk hook re-reads targets.conf on next launch.
force_stop_pkg() {
    has_cmd am || return 0
    if am force-stop "$1" >/dev/null 2>&1; then
        log_info "force-stop: $1"
        echo "Force-stopped: $1"
    else
        log_info "force-stop failed: $1"
    fi
}

need_pkg() {
    is_valid_package "$1" || { echo "ERROR: invalid package name: ${1:-<empty>}" >&2; exit 1; }
}

need_ren() {
    is_valid_renderer "$1" || { echo "ERROR: renderer must be skiavk or skiagl (got: ${1:-<empty>})" >&2; exit 1; }
}

cmd_target() {
    sub=$1
    # validate BEFORE taking the lock, and say why on stderr
    case "$sub" in
        add|set) need_pkg "$2"; need_ren "$3" ;;
        remove|get|enable|disable) need_pkg "$2" ;;
    esac
    case "$sub" in
        add|remove|set|enable|disable)
            acquire_lock targets 10 || { echo "ERROR: targets busy" >&2; exit 6; }
            trap 'release_lock targets' EXIT
            trap 'exit 130' INT
            trap 'exit 143' TERM
            ;;
    esac
    case "$sub" in
        list) target_list ;;
        add)
            target_add "$2" "$3" || exit $?
            echo "Target added: $2 -> $3"
            force_stop_pkg "$2"
            ;;
        remove)
            target_remove "$2" || exit $?
            # Confirm gone from file (stdout is what WebUI relies on)
            if target_exists "$2"; then
                echo "ERROR: still present after remove: $2" >&2
                exit 3
            fi
            echo "Removed: $2"
            force_stop_pkg "$2"
            ;;
        get)
            r=$(target_get_renderer "$2") || { echo "Not found" >&2; exit 2; }
            echo "$2 -> $r"
            target_is_enabled "$2" && echo "enabled: yes" || echo "enabled: no"
            ;;
        set)
            target_set_renderer "$2" "$3" || { rc=$?; echo "ERROR: set failed (rc=$rc): $2 (not a target? use: target add)" >&2; exit $rc; }
            # Verify what is actually on disk before reporting success
            now=$(target_get_renderer "$2")
            if [ "$now" != "$3" ]; then
                echo "ERROR: not persisted: $2 is '$now', wanted '$3'" >&2
                exit 3
            fi
            echo "Updated: $2 -> $3"
            force_stop_pkg "$2"
            ;;
        enable)
            target_set_enabled "$2" 1 || { rc=$?; echo "ERROR: enable failed (rc=$rc): $2" >&2; exit $rc; }
            echo "Enabled: $2"
            force_stop_pkg "$2"
            ;;
        disable)
            target_set_enabled "$2" 0 || { rc=$?; echo "ERROR: disable failed (rc=$rc): $2" >&2; exit $rc; }
            echo "Disabled: $2"
            force_stop_pkg "$2"
            ;;
        *) echo "Unknown target subcommand" >&2; exit 1 ;;
    esac
}

# Bootloop guard (scripts/boot.sh) switches enforcement off for good after
# repeated failed boots. This is the way back.
cmd_enforcement() {
    case "${1:-status}" in
        status)
            if [ "$ENFORCEMENT_DISABLED" = "1" ]; then echo "disabled"; else echo "active"; fi
            ;;
        reset)
            save_setting ENFORCEMENT_DISABLED 0
            ENFORCEMENT_DISABLED=0
            echo 0 > "$BOOT_COUNTER" 2>/dev/null
            log_info "enforcement re-enabled, boot counter reset"
            renderer_set_global "${GLOBAL_RENDERER:-$DEFAULT_GLOBAL_RENDERER}" >/dev/null 2>&1
            echo "Enforcement enabled, boot counter reset"
            ;;
        *) echo "enforcement status|reset" >&2; exit 1 ;;
    esac
}

# Is a Zygisk implementation installed?   skiactl zygisk [-v]
#   prints ok | missing | unknown      exit 0 | 1 | 2
# Checked in this order (first hit wins):
#   1. Magisk built-in Zygisk        (Settings -> Zygisk)
#   2. library files shipped by Zygisk implementations: libzygisk.so /
#      libzygisk64.so in an enabled module, or in /data/adb/ksu/lib
# "unknown" = we could not look (not root / modules dir unreadable / the
# Magisk database query failed) -- never reported as "missing".
# This checks presence, not that it is running this boot; for that see the
# Zygisk lines in `skiactl logs`.
cmd_zygisk() {
    mods="${MODULES_DIR:-/data/adb/modules}"
    ksulib="${KSU_LIB_DIR:-/data/adb/ksu/lib}"
    verbose=0
    [ "$1" = "-v" ] && verbose=1
    uncertain=0

    zy_ok() {
        [ "$verbose" = "1" ] && echo "ok ($1)" || echo ok
        return 0
    }

    # 1. Magisk built-in Zygisk
    if has_cmd magisk; then
        out=$(magisk --sqlite "SELECT value FROM settings WHERE key='zygisk'" 2>/dev/null)
        rc=$?
        if [ "$rc" -ne 0 ]; then
            uncertain=1
        else
            v=$(printf '%s\n' "$out" | sed -n 's/^value=//p' | head -n 1)
            [ "$v" = "1" ] && { zy_ok "Magisk built-in Zygisk"; return 0; }
        fi
    fi

    if [ ! -r "$mods" ] || [ ! -x "$mods" ]; then
        uncertain=1
    else
        # 2. implementation library files (skip disabled / pending-removal modules)
        for d in "$mods"/*; do
            [ -d "$d" ] || continue
            [ -f "$d/disable" ] && continue
            [ -f "$d/remove" ] && continue
            if find "$d" \( -name libzygisk.so -o -name libzygisk64.so \) 2>/dev/null | grep -q .; then
                zy_ok "library in module ${d##*/}"
                return 0
            fi
        done
        if [ -d "$ksulib" ] && \
           find "$ksulib" \( -name libzygisk.so -o -name libzygisk64.so \) 2>/dev/null | grep -q .; then
            zy_ok "library in $ksulib"
            return 0
        fi
    fi

    if [ "$uncertain" = "1" ]; then
        echo unknown
        return 2
    fi
    echo missing
    return 1
}

cmd_logs() {
    [ -f "$LOG_FILE" ] && tail -n 100 "$LOG_FILE" || echo "(no logs)"
}

[ $# -lt 1 ] && { usage; exit 1; }
cmd=$1; shift
case "$cmd" in
    status)   cmd_status ;;
    renderer) cmd_renderer "$@" ;;
    target)   cmd_target "$@" ;;
    enforcement) cmd_enforcement "$@" ;;
    zygisk)   cmd_zygisk "$@" ;;
    logs)     cmd_logs ;;
    packages) list_installed_packages "${1:-user}" ;;
    help|-h|--help) usage ;;
    *) echo "Unknown: $cmd" >&2; usage; exit 1 ;;
esac
